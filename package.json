{
  "name": "quicksplit",
  "version": "1.0.0",
  "description": "QuickSplit - Minimalist Expense Splitter with Cashfree Payment Gateway",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "start:backend": "node backend/server.js",
    "start:frontend": "serve frontend -l 3000",
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run start:backend\" \"npm run start:frontend\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "serve": "^14.2.4"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
